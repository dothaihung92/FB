# ==== Facebook Graph API ====
# Tạo App tại https://developers.facebook.com/apps -> thêm sản phẩm "Facebook Login for Business" + "Pages API"
# Cấp quyền: pages_manage_posts, pages_read_engagement, pages_read_user_content,
#            pages_messaging (nếu dùng auto-reply Messenger), pages_show_list
# Lấy Page Access Token (dài hạn) qua Graph API Explorer hoặc OAuth flow, rồi đổi sang
# never-expiring token bằng /oauth/access_token (xem README.md phần "Lấy Page Access Token").
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
# Verify token tự chọn, dùng khi cấu hình Webhook (Messenger/Comments realtime, optional)
FB_WEBHOOK_VERIFY_TOKEN=change_me

# ==== Anthropic Claude API (sinh nội dung AI) ====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ==== App ====
PORT=3000
# Khoá đơn giản để bảo vệ dashboard (Basic Auth)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me
# Múi giờ dùng cho lịch đăng bài (cron)
TIMEZONE=Asia/Ho_Chi_Minh
# Bật/tắt tự động đăng bài theo lịch mà không cần duyệt tay (true/false)
AUTO_PUBLISH=false
# Bật/tắt tự động trả lời bình luận
AUTO_REPLY_COMMENTS=true
