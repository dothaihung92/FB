# ==== Facebook Graph API ====
# Buoc 1 (bat buoc, chi lam 1 lan, khong the tu dong hoa vi Meta yeu cau dang
# nhap bang chinh tai khoan cua ban): tao App tai https://developers.facebook.com/apps
# -> them san pham "Facebook Login for Business" -> vao "Facebook Login > Settings",
# them Valid OAuth Redirect URI: http://localhost:3000/connect/facebook/callback
# -> vao "App Settings > Basic" lay App ID + App Secret dien vao 2 dong duoi day.
FB_APP_ID=
FB_APP_SECRET=

# Buoc 2: KHONG can dien tay. Sau khi khoi dong app, vao muc "Ket noi Facebook"
# tren dashboard, bam nut va dang nhap Facebook nhu binh thuong - he thong se
# tu dong lay FB_PAGE_ID va FB_PAGE_ACCESS_TOKEN va luu vao data/store.json.
# Chi dien tay 2 dong duoi day neu ban muon tu lay token qua Graph API Explorer
# (xem huong dan chi tiet trong README.md).
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Verify token tự chọn, dùng khi cấu hình Webhook (Messenger/Comments realtime, optional)
FB_WEBHOOK_VERIFY_TOKEN=change_me

# ==== AI sinh noi dung (chon 1 trong 3 nha cung cap) ====
# Co the cau hinh o day HOAC (de hon) vao dashboard sau khi chay app, muc
# "Cai dat AI" - chon nha cung cap + dan API key ngay tren giao dien, khong
# can sua file nay va khong can khoi dong lai.
# AI_PROVIDER = "claude" | "gemini" | "glm".
AI_PROVIDER=claude

# --- Anthropic Claude --- (lay API key tai https://console.anthropic.com/)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Google Gemini --- (lay API key mien phi tai https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- GLM (Zhipu AI / Z.ai) --- (lay API key tai https://open.bigmodel.cn/)
# Neu dung dich vu quoc te thay vi Trung Quoc, doi GLM_BASE_URL thanh:
# https://api.z.ai/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ==== App ====
PORT=3000
# Khoá đơn giản để bảo vệ dashboard (Basic Auth)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me
# Múi giờ dùng cho lịch đăng bài (cron)
TIMEZONE=Asia/Ho_Chi_Minh
# Bật/tắt tự động đăng bài theo lịch mà không cần duyệt tay (true/false)
AUTO_PUBLISH=false
# Bật/tắt tự động trả lời bình luận
AUTO_REPLY_COMMENTS=true
