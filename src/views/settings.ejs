<%- include('partials/header', { active: 'settings' }) %>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="card">
  <h3>🧠 Cài đặt AI viết nội dung</h3>
  <p class="meta">Chọn nhà cung cấp AI và dán API key ngay tại đây — không cần sửa file .env,
    áp dụng ngay lập tức, không cần khởi động lại phần mềm.</p>

  <form method="post" action="/settings">
    <div class="card" style="background:#0c1526;">
      <label>
        <input type="radio" name="provider" value="claude" <%= provider === 'claude' ? 'checked' : '' %> />
        <strong>Claude (Anthropic)</strong> — chất lượng cao nhất, trả phí
      </label>
      <div class="row">
        <input type="text" name="anthropic_api_key" placeholder="<%= claude.hasKey ? claude.maskedKey : 'sk-ant-...' %>" style="flex:1;" />
      </div>
      <div class="row">
        <label style="color:#93a1c4; font-size:12px;">Model:</label>
        <input type="text" name="claude_model" value="<%= claude.model %>" />
      </div>
      <p class="meta">Lấy API key tại <a href="https://console.anthropic.com/" target="_blank" rel="noopener">console.anthropic.com</a></p>
    </div>

    <div class="card" style="background:#0c1526;">
      <label>
        <input type="radio" name="provider" value="gemini" <%= provider === 'gemini' ? 'checked' : '' %> />
        <strong>Gemini (Google)</strong> — có gói miễn phí
      </label>
      <div class="row">
        <input type="text" name="gemini_api_key" placeholder="<%= gemini.hasKey ? gemini.maskedKey : 'AIzaSy...' %>" style="flex:1;" />
      </div>
      <div class="row">
        <label style="color:#93a1c4; font-size:12px;">Model:</label>
        <input type="text" name="gemini_model" value="<%= gemini.model %>" />
      </div>
      <p class="meta">Lấy API key miễn phí tại <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a></p>
    </div>

    <div class="card" style="background:#0c1526;">
      <label>
        <input type="radio" name="provider" value="glm" <%= provider === 'glm' ? 'checked' : '' %> />
        <strong>GLM (Zhipu AI / Z.ai)</strong>
      </label>
      <div class="row">
        <input type="text" name="glm_api_key" placeholder="<%= glm.hasKey ? glm.maskedKey : 'API key GLM...' %>" style="flex:1;" />
      </div>
      <div class="row">
        <label style="color:#93a1c4; font-size:12px;">Model:</label>
        <input type="text" name="glm_model" value="<%= glm.model %>" />
      </div>
      <div class="row">
        <label style="color:#93a1c4; font-size:12px;">Base URL:</label>
        <input type="text" name="glm_base_url" value="<%= glm.baseUrl %>" style="flex:1;" />
      </div>
      <p class="meta">Lấy API key tại <a href="https://open.bigmodel.cn/" target="_blank" rel="noopener">open.bigmodel.cn</a>
        (dùng dịch vụ quốc tế thì đổi Base URL thành <code>https://api.z.ai/api/paas/v4</code>).
        Kiểm tra đúng tên model đang hỗ trợ trong tài liệu nhà cung cấp nếu <code><%= glm.model %></code> báo lỗi không tồn tại.</p>
    </div>

    <div class="row">
      <button type="submit">💾 Lưu cài đặt</button>
    </div>
  </form>

  <form method="post" action="/settings/test" style="margin-top:8px;">
    <button type="submit" class="secondary">🔍 Kiểm tra kết nối (sinh thử 1 chủ đề)</button>
  </form>
</div>

<div class="card">
  <h3>📢 Cài đặt Ads (Facebook Ads + Google Ads)</h3>
  <p class="meta">Chưa có tài khoản/token? Xem hướng dẫn từng bước trong <code>HUONG_DAN_ADS.md</code>
    ở thư mục gốc dự án. Mặc định <strong>chế độ mô phỏng (Dry-run) đang BẬT</strong> — mọi chiến dịch
    "duyệt & đẩy lên" ở tab Quảng cáo sẽ chỉ giả lập, không tốn tiền, cho tới khi bạn tắt ở đây.</p>

  <form method="post" action="/settings/ads">
    <div class="card" style="background:#0c1526;">
      <label>
        <input type="checkbox" name="ads_dry_run" value="false" <%= ads.dryRun ? '' : 'checked' %> />
        Tắt chế độ mô phỏng (chạy quảng cáo THẬT — chỉ tick khi đã kiểm tra kỹ token/ngân sách)
      </label>
      <div class="row">
        <label>Trần ngân sách/ngày (VNĐ) — AI không được đề xuất vượt mức này:
          <input type="text" name="ads_budget_cap_vnd" value="<%= ads.budgetCap %>" placeholder="VD: 200000" />
        </label>
      </div>
    </div>

    <div class="card" style="background:#0c1526;">
      <strong>Facebook Ads</strong>
      <div class="row">
        <label style="flex:1;">Ad Account ID: <input type="text" name="fb_ad_account_id" value="<%= ads.fbAdAccountId %>" placeholder="act_123456789" style="width:100%;" /></label>
      </div>
      <div class="row">
        <label style="flex:1;">Access Token (quyền ads_management/ads_read):
          <input type="text" name="fb_ads_access_token" placeholder="<%= ads.fbAdsTokenSet ? ads.fbAdsTokenMasked : 'EAAG...' %>" style="width:100%;" />
        </label>
      </div>
      <div class="row">
        <label style="flex:1;">Pixel ID (để retarget):
          <input type="text" name="fb_pixel_id" value="<%= ads.fbPixelId %>" style="width:100%;" />
        </label>
      </div>
    </div>

    <div class="card" style="background:#0c1526;">
      <strong>Google Ads</strong>
      <div class="row">
        <label style="flex:1;">Developer Token:
          <input type="text" name="google_ads_developer_token" placeholder="<%= ads.googleDeveloperTokenSet ? ads.googleDeveloperTokenMasked : '...' %>" style="width:100%;" />
        </label>
      </div>
      <div class="row">
        <label style="flex:1;">OAuth Client ID: <input type="text" name="google_ads_client_id" value="<%= ads.googleClientId %>" style="width:100%;" /></label>
      </div>
      <div class="row">
        <label style="flex:1;">OAuth Client Secret:
          <input type="text" name="google_ads_client_secret" placeholder="<%= ads.googleClientSecretSet ? ads.googleClientSecretMasked : '...' %>" style="width:100%;" />
        </label>
      </div>
      <div class="row">
        <label style="flex:1;">Refresh Token:
          <input type="text" name="google_ads_refresh_token" placeholder="<%= ads.googleRefreshTokenSet ? ads.googleRefreshTokenMasked : '...' %>" style="width:100%;" />
        </label>
      </div>
      <div class="row">
        <label>Customer ID: <input type="text" name="google_ads_customer_id" value="<%= ads.googleCustomerId %>" placeholder="123-456-7890" /></label>
        <label>Login Customer ID (nếu dùng Manager Account): <input type="text" name="google_ads_login_customer_id" value="<%= ads.googleLoginCustomerId %>" /></label>
      </div>
    </div>

    <div class="row">
      <button type="submit">💾 Lưu cài đặt Ads</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
