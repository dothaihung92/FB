<%- include('partials/header', { active: 'leads' }) %>

<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

<div class="card">
  <h3>Quét bình luận mới để tìm khách tiềm năng</h3>
  <form method="post" action="/leads/scan">
    <button type="submit">🔍 Quét ngay</button>
  </form>
</div>

<% if (!leads.length) { %>
  <div class="empty">Chưa có khách tiềm năng nào được phát hiện. Hãy đăng bài và bấm "Quét ngay".</div>
<% } %>

<% leads.forEach(function(lead) { %>
  <div class="card">
    <div class="meta">
      #<%= lead.id %> · <%= lead.fb_user_name || 'Ẩn danh' %> ·
      nguồn: <%= lead.source %> · <%= lead.created_at %>
      <% if (lead.replied) { %> · <span class="badge published">đã trả lời</span><% } %>
      <% if (lead.contact_info) { %> · 📞 <%= lead.contact_info %><% } %>
    </div>
    <div class="row">
      <span class="score" style="color: <%= lead.interest_score >= 60 ? '#22c55e' : (lead.interest_score >= 30 ? '#f59e0b' : '#93a1c4') %>">
        Điểm tiềm năng: <%= lead.interest_score %>/100
      </span>
    </div>
    <p><strong>Bình luận:</strong> <%= lead.message %></p>

    <form method="post" action="/leads/<%= lead.id %>/reply">
      <textarea name="message"><%= lead.ai_reply %></textarea>
      <div class="row">
        <button type="submit">💬 Gửi phản hồi này</button>
      </div>
    </form>
  </div>
<% }); %>

<%- include('partials/footer') %>
